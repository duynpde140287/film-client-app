{
  "name": "projectx-client-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=1024 --max-semi-space-size=8 scripts/desktop.mjs --dev",
    "start": "node scripts/desktop.mjs",
    "start:dev": "node --max-old-space-size=1024 --max-semi-space-size=8 scripts/desktop.mjs --dev",
    "build": "node --max-old-space-size=1024 --max-semi-space-size=8 ./node_modules/vite/bin/vite.js build",
    "desktop": "node scripts/desktop.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node --max-old-space-size=1024 --max-semi-space-size=8 scripts/check-ui.mjs",
    "package:win": "npm run build && node --max-old-space-size=1024 --max-semi-space-size=8 scripts/package-win.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "nw": "^0.99.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
